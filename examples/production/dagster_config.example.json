{
  "format": "root4duckdb-production-config-v1",
  "project_dir": "../..",
  "workspace": "/tmp/root4duckdb-demo/work",
  "chunks_dir": "/tmp/root4duckdb-demo/chunks",
  "inputs": [
    "/data/events/*.root*"
  ],
  "recursive": false,
  "tree": "PaEvent",
  "paths_file": "paths-paevent-minimal.json",
  "dictionary": "/data/libExperiment.so",
  "duckdb": "../../build/release/duckdb",
  "execution_backend": "htcondor",
  "attach_sql": "attach-iceberg-rest.example.sql",
  "compaction_sql": "iceberg_compaction.sql.example",
  "resources": {
    "target_chunk_seconds": 21600,
    "throughput_bytes_per_second": 35000000,
    "request_memory_mb": 28000,
    "threads": 4
  },
  "htcondor": {
    "job_flavour": "workday"
  },
  "iceberg": {
    "enabled": true,
    "catalog": "experiment_iceberg",
    "namespace": "root4duckdb",
    "prefix": "example_period",
    "require_compaction": true
  },
  "dagster": {
    "retries": 3,
    "retry_delay_seconds": 30,
    "cleanup_orphans": false
  }
}
